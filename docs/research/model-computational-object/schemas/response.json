{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "request_id",
    "request_ref",
    "model_ref",
    "recommendation",
    "evidence_refs",
    "rationale"
  ],
  "properties": {
    "schema": {
      "const": "mco.response.v1"
    },
    "request_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{32}$",
      "minLength": 32,
      "maxLength": 32
    },
    "request_ref": {
      "$ref": "#/$defs/ref"
    },
    "model_ref": {
      "$ref": "#/$defs/ref"
    },
    "recommendation": {
      "enum": [
        "endorse",
        "reject",
        "review"
      ]
    },
    "evidence_refs": {
      "type": "array",
      "minItems": 1,
      "maxItems": 3,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/ref"
      }
    },
    "rationale": {
      "type": "string",
      "maxLength": 512
    }
  },
  "$defs": {
    "ref": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$",
      "minLength": 71,
      "maxLength": 71
    }
  }
}
