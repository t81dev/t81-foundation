{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "request_id",
    "model_ref",
    "operation",
    "artifact_ref",
    "policy_ref",
    "evidence_refs",
    "budget_units",
    "deadline_tick"
  ],
  "properties": {
    "schema": {
      "const": "mco.request.v1"
    },
    "request_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{32}$",
      "minLength": 32,
      "maxLength": 32
    },
    "model_ref": {
      "$ref": "#/$defs/ref"
    },
    "operation": {
      "const": "append_report"
    },
    "artifact_ref": {
      "$ref": "#/$defs/ref"
    },
    "policy_ref": {
      "$ref": "#/$defs/ref"
    },
    "evidence_refs": {
      "type": "array",
      "minItems": 1,
      "maxItems": 3,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/ref"
      }
    },
    "budget_units": {
      "type": "integer",
      "minimum": 1,
      "maximum": 8
    },
    "deadline_tick": {
      "type": "integer",
      "minimum": 0,
      "maximum": 65535
    }
  },
  "$defs": {
    "ref": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$",
      "minLength": 71,
      "maxLength": 71
    }
  }
}
