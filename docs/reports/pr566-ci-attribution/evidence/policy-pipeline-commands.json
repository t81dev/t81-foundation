    "name": "Install Python tools",
    "shell": "GitHub implicit bash -e",
    "commands": [
      "pip install mdformat mdformat-gfm mdformat-frontmatter mdformat-toc 2>&1 | tee -a .github/logs/spec-and-docs.log"
    ]
