+        (p/'signature').write_bytes(signature)
+        result = subprocess.run([executable, 'pkeyutl', '-verify', '-rawin', '-pubin', '-inkey', str(p/'public.der'),
+                                 '-keyform', 'DER', '-in', str(p/'message'), '-sigfile', str(p/'signature')], capture_output=True)
