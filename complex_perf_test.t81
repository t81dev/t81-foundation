fn main() -> i32 {
  // Complex performance test
  let mut sum: T81BigInt = 0t81;
  let mut i: T81BigInt = 0t81;
  
  while i < 100t81 {
    sum = sum + i;
    i = i + 1t81;
  }
  
  let vec: Vector[i32] = [1, 2, 3, 4, 5];
  let mut vec_sum: i32 = 0;
  let mut idx: i32 = 0;
  
  while idx < 5 {
    vec_sum = vec_sum + vec[idx];
    idx = idx + 1;
  }
  
  print(sum);
  print(vec_sum);
  return 0;
}
