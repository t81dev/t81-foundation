{
  "name": "t81-bundle-support",
  "displayName": "T81 Bundle Support",
  "description": "Language support for T81 decision bundles",
  "version": "1.0.0",
  "publisher": "t81-foundation",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/t81dev/t81-foundation"
  },
  "engines": {
    "vscode": "^1.80.0"
  },
  "categories": [
    "Languages",
    "Snippets"
  ],
  "contributes": {
    "languages": [
      {
        "id": "t81-bundle",
        "aliases": [
          "t81-bundle",
          "bundle"
        ],
        "extensions": [
          ".t81-bundle"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "t81-bundle",
        "scopeName": "source.t81-bundle",
        "path": "./syntaxes/t81.tmLanguage.json"
      }
    ]
  }
}