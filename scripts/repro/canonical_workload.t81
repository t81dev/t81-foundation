# File: scripts/repro/canonical_workload.t81
# Purpose: Canonical T81 workload for reproducibility verification across platforms
# Description: Comprehensive workload that exercises core VM features for determinism testing

fn main() -> i32 {
    // Basic arithmetic operations
    let a: T81Int = 42;
    let b: T81Int = -17;
    let sum: T81Int = a + b;
    let product: T81Int = a * b;
    
    // Floating point operations
    let pi: T81Float = 3.14159t81;
    let e: T81Float = 2.71828t81;
    let float_sum: T81Float = pi + e;
    
    // Big integer operations
    let big_a: T81BigInt = 12345678901234567890t81;
    let big_b: T81BigInt = 98765432109876543210t81;
    let big_sum: T81BigInt = big_a + big_b;
    
    // String operations
    let greeting: T81String = "Hello, T81!";
    let message: T81String = "Reproducibility test";
    let combined: T81String = greeting + " " + message;
    
    // Container operations
    let numbers: [T81Int] = [1, 2, 3, 4, 5];
    let sum_all: T81Int = 0;
    for num in numbers {
        sum_all = sum_all + num;
    }
    
    // Map operations
    let map: {T81String: T81Int} = {"one": 1, "two": 2, "three": 3};
    let map_sum: T81Int = map["one"] + map["two"] + map["three"];
    
    // Conditional logic
    let result: T81String;
    if (sum_all > 10) {
        result = "Greater than 10";
    } else {
        result = "Less than or equal to 10";
    }
    
    // Print some values for verification
    print("Basic arithmetic: " + sum);
    print("Float operations: " + float_sum);
    print("Big integer: " + big_sum);
    print("String concat: " + combined);
    print("Array sum: " + sum_all);
    print("Map sum: " + map_sum);
    print("Conditional result: " + result);
    
    return 0;
}
