// 53 = SubmitEpoch (conditional: T81_ENABLE_DPE; reserved unconditionally)
.equ KCALL_SubmitEpoch,                     53

// ── Wire format magic (split for movk sequences) ──────────────────────────────
// kKernelAbiWireRequestMagic  = 0x4B415152  ("KAQR" little-endian)
// kKernelAbiWireResponseMagic = 0x4B415250  ("KARP" little-endian)

.equ KCALL_REQ_MAGIC_LO,   0x5152    // low  16 bits of kKernelAbiWireRequestMagic
.equ KCALL_REQ_MAGIC_HI,   0x4B41    // high 16 bits of kKernelAbiWireRequestMagic
.equ KCALL_RSP_MAGIC_LO,   0x4250    // low  16 bits of kKernelAbiWireResponseMagic
.equ KCALL_RSP_MAGIC_HI,   0x4B41    // high 16 bits of kKernelAbiWireResponseMagic

// ── Wire format version ───────────────────────────────────────────────────────

.equ KCALL_WIRE_VERSION,   1         // kKernelAbiWireVersion

// ── Minimum block sizes (for x1/x3 in SVC #1) ────────────────────────────────

.equ KCALL_MIN_REQ_BYTES,  12        // minimum valid request block
.equ KCALL_MIN_RSP_BYTES,  48        // minimum response block (through caller_tid)
