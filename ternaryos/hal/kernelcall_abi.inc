// ternaryos/hal/kernelcall_abi.inc
//
// KernelCall ABI symbolic constants for EL0 AArch64 assembly.
// RFC-00BD: KernelCall ABI Ordinal Freeze.
//
// DO NOT embed literal KernelCallKind ordinals in assembly; use these symbols.
// DO NOT edit this file without a corresponding update to:
//   kernel_abi.hpp (source of truth)
//   spec/rfcs/kernelcall_abi_manifest.txt (CI golden manifest)
//
// Kept in sync by: scripts/ci/check_kernelcall_abi_freeze.py
// Frozen as of: RFC-00BC acceptance (commit afbc41bf, 2026-03-23)

// ── KernelCallKind ordinals ───────────────────────────────────────────────────

.equ KCALL_Yield,                           0
.equ KCALL_SpawnThreadInCallerGroup,        1
.equ KCALL_SpawnThreadUnderSupervisor,      2
.equ KCALL_RegisterThreadEntryDescriptor,   3
.equ KCALL_RegisterExecutableObject,        4
.equ KCALL_PublishExecutableObjectFromTva,  5
.equ KCALL_RegisterExecutableObjectFromTva, 6
.equ KCALL_QueryExecutableObject,           7
.equ KCALL_SpawnThreadFromExecutableObject, 8
.equ KCALL_SpawnThreadFromEntryDescriptor,  9
.equ KCALL_GetThreadIdentity,               10
.equ KCALL_QueryThreadExecutionState,       11
.equ KCALL_ExitThread,                      12
.equ KCALL_SendMessage,                     13
.equ KCALL_ReceiveMessage,                  14
.equ KCALL_ReadFaultInbox,                  15
.equ KCALL_AcknowledgeThreadFault,          16
.equ KCALL_AcknowledgeSupervisorFaultGroup, 17
.equ KCALL_QueryProcessGroupMemory,         18
.equ KCALL_SetAddressSpaceBootCritical,     19
.equ KCALL_QueryRuntimeStatus,              20
.equ KCALL_QueryFaultSummary,               21
.equ KCALL_QuerySupervisorStatus,           22
.equ KCALL_QuerySupervisorRecoveryStatus,   23
.equ KCALL_QuerySupervisorServiceStatus,    24
.equ KCALL_QuerySupervisorServiceInventory, 25
.equ KCALL_QuerySupervisorCapabilityInventory, 26
.equ KCALL_QuerySupervisorDelegationSummary,27
.equ KCALL_QueryCapabilityTransitionHistory,28
.equ KCALL_QueryCapabilities,               29
.equ KCALL_QueryDelegatedCapabilities,      30
.equ KCALL_QueryCapabilityRecord,           31
.equ KCALL_GrantCapability,                 32
.equ KCALL_RevokeCapability,                33
.equ KCALL_RevokeDelegatedCapabilities,     34
.equ KCALL_RegisterService,                 35
.equ KCALL_SpawnThreadForService,           36
.equ KCALL_QueryServiceStatus,              37
.equ KCALL_SuspendService,                  38
.equ KCALL_ResumeService,                   39
.equ KCALL_MarkServiceUnhealthy,            40
.equ KCALL_MarkServiceHealthy,              41
.equ KCALL_BlockOnIpcReceive,               42   // RFC-00BE scheduler yield point
.equ KCALL_WaitForDevice,                   43   // RFC-00BE scheduler yield point
.equ KCALL_RequestPageMapping,              44
.equ KCALL_WaitForPagerHandoff,             45
.equ KCALL_ResumePageFaultedThread,         46
