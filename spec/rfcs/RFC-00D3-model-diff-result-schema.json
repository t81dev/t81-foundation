{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://t81.foundation/schemas/rfc-00d3-model-diff-result.schema.json",
  "title": "RFC-00D3 Model Diff Result",
  "description": "Schema for t81.model-diff.v1 result documents emitted by the model diff CLI surface.",
  "type": "object",
  "oneOf": [
    {
      "$ref": "#/$defs/successResult"
    },
    {
      "$ref": "#/$defs/failureResult"
    }
  ],
  "$defs": {
    "stringArray": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "successResult": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "lhs",
        "rhs",
        "identical",
        "lhs_format",
        "rhs_format",
        "lhs_tensor_count",
        "rhs_tensor_count",
        "lhs_parameters",
        "rhs_parameters",
        "lhs_trits",
        "rhs_trits",
        "lhs_only_count",
        "rhs_only_count",
        "changed_count",
        "provenance_lhs_only_count",
        "provenance_rhs_only_count",
        "provenance_changed_count",
        "lhs_only",
        "rhs_only",
        "changed",
        "provenance_lhs_only",
        "provenance_rhs_only",
        "provenance_changed"
      ],
      "properties": {
        "schema": {
          "const": "t81.model-diff.v1"
        },
        "lhs": {
          "type": "string",
          "minLength": 1
        },
        "rhs": {
          "type": "string",
          "minLength": 1
        },
        "identical": {
          "type": "boolean"
        },
        "lhs_format": {
          "type": "string",
          "minLength": 1
        },
        "rhs_format": {
          "type": "string",
          "minLength": 1
        },
        "lhs_tensor_count": {
          "type": "integer",
          "minimum": 0
        },
        "rhs_tensor_count": {
          "type": "integer",
          "minimum": 0
        },
        "lhs_parameters": {
          "type": "integer",
          "minimum": 0
        },
        "rhs_parameters": {
          "type": "integer",
          "minimum": 0
        },
        "lhs_trits": {
          "type": "integer",
          "minimum": 0
        },
        "rhs_trits": {
          "type": "integer",
          "minimum": 0
        },
        "lhs_only_count": {
          "type": "integer",
          "minimum": 0
        },
        "rhs_only_count": {
          "type": "integer",
          "minimum": 0
        },
        "changed_count": {
          "type": "integer",
          "minimum": 0
        },
        "provenance_lhs_only_count": {
          "type": "integer",
          "minimum": 0
        },
        "provenance_rhs_only_count": {
          "type": "integer",
          "minimum": 0
        },
        "provenance_changed_count": {
          "type": "integer",
          "minimum": 0
        },
        "lhs_only": {
          "$ref": "#/$defs/stringArray"
        },
        "rhs_only": {
          "$ref": "#/$defs/stringArray"
        },
        "changed": {
          "$ref": "#/$defs/stringArray"
        },
        "provenance_lhs_only": {
          "$ref": "#/$defs/stringArray"
        },
        "provenance_rhs_only": {
          "$ref": "#/$defs/stringArray"
        },
        "provenance_changed": {
          "$ref": "#/$defs/stringArray"
        }
      }
    },
    "failureResult": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema", "lhs", "rhs", "error"],
      "properties": {
        "schema": {
          "const": "t81.model-diff.v1"
        },
        "lhs": {
          "type": "string",
          "minLength": 1
        },
        "rhs": {
          "type": "string",
          "minLength": 1
        },
        "error": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}
