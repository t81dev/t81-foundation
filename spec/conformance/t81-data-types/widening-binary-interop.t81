// spec/conformance/t81-data-types/widening-binary-interop.t81
// Normative ref: spec/t81-data-types.md §11.4, §11.8
// Invariant: Binary interop types (i2, i8, i16, i32) form a complete widening
//            sub-chain. i2 maps to {-1, 0, +1} like T81Qutrit but with binary
//            two's-complement encoding. Each widen step is value-preserving.
//
// @spec-ref: spec/t81-data-types.md §11.4 §11.8
// @invariant: widening-binary-interop-chain
// @input-domain: T81Qutrit({-1, 0, +1}) seed values widened across i8 → i16 → i32
// @expected: no TypeFault; widening chain preserves value identity

@tier(1) @pure
fn check_i2_to_i8() -> bool {
    // Seed with qutrit +1, then widen to i8.
    let q: T81Qutrit = 1t;
    let b: i8 = q as i8;
    b == 1i8
}

@tier(1) @pure
fn check_i2_negative_to_i8() -> bool {
    // Seed with qutrit -1, then widen to i8.
    let q: T81Qutrit = -1t;
    let b: i8 = q as i8;
    b == -1i8
}

@tier(1) @pure
fn check_i8_to_i16() -> bool {
    // Widen a representable i8 value produced from qutrit.
    let q: T81Qutrit = 1t;
    let a: i8 = q as i8;
    let b: i16 = a as i16;
    b == 1i16
}

@tier(1) @pure
fn check_i16_to_i32() -> bool {
    // Widen a negative value through the chain and preserve sign.
    let q: T81Qutrit = -1t;
    let a: i16 = (q as i8) as i16;
    let b: i32 = a as i32;
    b == -1i32
}

@tier(1) @pure
fn check_full_binary_chain() -> bool {
    // qutrit seed → i8 → i16 → i32 full chain.
    let q: T81Qutrit = 1t;
    let b: i8 = q as i8;
    let c: i16 = b as i16;
    let d: i32 = c as i32;
    d == 1i32
}

@tier(1) @pure
fn check_i2_zero_chain() -> bool {
    // Zero widens to zero at every step.
    let q: T81Qutrit = 0t;
    let b: i8 = q as i8;
    let c: i16 = b as i16;
    let d: i32 = c as i32;
    d == 0i32
}

@axion_verify
fn main() -> void {
    assert check_i2_to_i8();
    assert check_i2_negative_to_i8();
    assert check_i8_to_i16();
    assert check_i16_to_i32();
    assert check_full_binary_chain();
    assert check_i2_zero_chain();
}
