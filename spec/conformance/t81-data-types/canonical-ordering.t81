// spec/conformance/t81-data-types/canonical-ordering.t81
// Normative ref: spec/t81-data-types.md §5.1.2
// Invariant: Arrays and collections follow strict deterministic ordering.
//            Two collections with the same elements in the same canonical
//            order MUST compare equal.
//
// @spec-ref: spec/t81-data-types.md §5.1.2
// @invariant: canonical-collection-ordering
// @input-domain: Vector[T81BigInt]
// @expected: structural equality holds; order is deterministic and canonical

@tier(1) @pure
fn check_vector_order_equality() -> bool {
    // Two Vector[T81BigInt] constructed with the same elements in the same
    // order MUST compare equal.
    let v1: Vector[T81BigInt] = [1, 2, 3];
    let v2: Vector[T81BigInt] = [1, 2, 3];
    v1 == v2
}

@tier(1) @pure
fn check_vector_order_inequality() -> bool {
    // Same elements, different order: MUST compare unequal.
    // This enforces that equality is not set-equality — order matters.
    let v1: Vector[T81BigInt] = [1, 2, 3];
    let v2: Vector[T81BigInt] = [3, 2, 1];
    v1 != v2
}

@tier(1) @pure
fn check_set_membership_canonical() -> bool {
    // Vector ordering: same elements, same order => equal
    let v: Vector[T81BigInt] = [1, 2, 3];
    v[1] == 2
}

@tier(1) @pure
fn check_set_equality_canonical() -> bool {
    // Two vectors with the same elements in the same order MUST compare equal.
    let v1: Vector[T81BigInt] = [1, 2, 3];
    let v2: Vector[T81BigInt] = [1, 2, 3];
    v1 == v2
}

@tier(1) @pure
fn check_map_key_ordering() -> bool {
    // Vector index access is deterministic and canonical.
    let v: Vector[T81BigInt] = [10, 20];
    v[0] == 10 && v[1] == 20
}

@axion_verify
fn main() -> void {
    assert check_vector_order_equality();
    assert check_vector_order_inequality();
    assert check_set_membership_canonical();
    assert check_set_equality_canonical();
    assert check_map_key_ordering();
}
