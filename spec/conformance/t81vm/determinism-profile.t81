// spec/conformance/t81vm/determinism-profile.t81
// Normative ref: spec/t81vm-spec.md §1 (Execution Modes), §2 (Determinism)
// Invariant: Under the determinism profile (Tier A), identical inputs produce
//            identical outputs on every execution and every conformant platform.
//            This holds for integer arithmetic, fraction arithmetic, and control
//            flow — all primitives in the governed deterministic surface.
//
// @spec-ref: spec/t81vm-spec.md §1 §2
// @invariant: determinism-profile-tier-a
// @input-domain: Fixed T81BigInt and T81Fraction values
// @expected: bit-exact outputs across platforms; no nondeterminism in governed surface

// These programs encode computations whose outputs are required to be bit-exact
// across any T81VM implementation claiming the determinism profile. A CI harness
// running this program on multiple platforms (x86-64 and ARM64) and comparing
// the AxionEvent trace hashes provides the cross-platform conformance evidence.

@tier(1) @pure
fn check_integer_determinism() -> bool {
    // A fixed sequence of integer operations MUST produce identical results
    // on every conformant T81VM, regardless of host architecture or OS.
    let a: T81BigInt = 6561;     // 81^2
    let b: T81BigInt = 81;
    let c: T81BigInt = a * b;    // 81^3 = 531441
    let d: T81BigInt = c / b;    // back to 81^2 = 6561
    d == 6561 && c == 531441
}

@tier(1) @pure
fn check_fraction_determinism() -> bool {
    // T81Fraction arithmetic is exact and must be bit-exact across platforms.
    // No host floating-point involved in the fraction pool path.
    let a: T81Fraction = 1 / 3;
    let b: T81Fraction = 2 / 3;
    let c: T81Fraction = a + b;   // 1/3 + 2/3 = 1 (canonical 1/1)
    c == 1 / 1
}

@tier(1) @pure
fn check_control_flow_determinism() -> bool {
    // Conditional branches must produce identical outcomes for identical inputs.
    let a: T81BigInt = 42;
    let result: T81BigInt = if a > 40 { 1 } else { 0 };
    result == 1
}

@tier(1) @pure
fn check_loop_determinism() -> bool {
    // A statically bounded loop must produce identical accumulated results.
    let mut sum: T81BigInt = 0;
    for i in 1..=5 {
        sum = sum + i;
    }
    sum == 15   // 1 + 2 + 3 + 4 + 5
}

@tier(1) @pure
fn check_trit_determinism() -> bool {
    // Ternary trit operations are canonical and must be bit-exact.
    let a: T81Qutrit = 1t;
    let b: T81Qutrit = -1t;
    let c: T81Qutrit = a & b;   // ternary min: min(+1, -1) = -1
    c == -1t
}

@axion_verify
fn main() -> void {
    assert check_integer_determinism();
    assert check_fraction_determinism();
    assert check_control_flow_determinism();
    assert check_loop_determinism();
    assert check_trit_determinism();
    // Axion MUST emit: spec_conformance pass segment=meta
    // CI cross-platform check: AxionEvent trace hash must be identical on
    // x86-64 and ARM64.
}
