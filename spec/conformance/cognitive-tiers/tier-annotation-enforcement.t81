// spec/conformance/cognitive-tiers/tier-annotation-enforcement.t81
// Normative ref: spec/cognitive-tiers.md §1 (Tier Structure)
//                spec/cognitive-tiers.md §2.1 (Static Tier Declarations)
// Invariant: @tier(N) annotation is numeric (1–5). Axion enforces the
//            N-tier constraint set on the annotated function. A @tier(1)
//            function may not exceed recursion depth 1, must have statically
//            bounded loops, and may not access AXREAD/AXSET. A @tier(2)
//            function may recurse up to depth 10 and operate on rank ≤ 3
//            tensors. Violations MUST raise a deterministic TierFault.
//
// @spec-ref: spec/cognitive-tiers.md §1 §2.1
// @invariant: tier-annotation-numeric-enforcement
// @input-domain: @tier(1) and @tier(2) annotated functions
// @expected: Tier 1 constraints enforced (bounded loop, depth ≤ 1);
//            Tier 2 constraints enforced (recursion ≤ 10); no TierFault

// Tier 0 note (per spec §1 Tier 0): Tier 0 is a validation state, not a
// computation tier. @tier(0) is reserved for load/validation; user code
// annotated @tier(0) MUST fault or be rejected by the compiler. User
// programs MUST use @tier(1) as their minimum computation tier annotation.

// ── Tier 1 positive tests ─────────────────────────────────────────────────

@tier(1) @pure
fn check_tier1_bounded_loop() -> bool {
    // Tier 1 constraint: loop iteration MUST be statically bounded.
    // A for-loop over a literal range satisfies the static-bound requirement.
    // Axion MUST NOT raise a TierFault for this loop.
    let mut acc: T81BigInt = 0;
    for i in 1..=5 {
        acc = acc + i;
    }
    acc == 15
}

@tier(1) @pure
fn check_tier1_no_indirect_recursion() -> bool {
    // Tier 1 constraint: recursion depth ≤ 1.
    // This function calls no other function that calls back to it.
    // Direct invocation chain depth is 0 here (no recursion).
    42 == 42
}

@tier(1) @pure
fn check_tier1_canonical_types() -> bool {
    // Tier 1 constraint: all types must be canonical.
    // Constructing canonical values and comparing them must succeed.
    let a: T81BigInt  = 81;
    let f: T81Fraction = 1 / 3;
    let q: T81Qutrit  = 1t;
    a == 81 && f == 1 / 3 && q == 1t
}

@tier(1) @pure
fn check_tier1_tensor_rank_limit() -> bool {
    // Tier 1 constraint: tensor rank ≤ 1 (vectors only).
    // A Vector[T81BigInt] is rank-1 — permitted at Tier 1.
    let v: Vector[T81BigInt] = [1, 2, 3];
    v[0] == 1 && v.len() == 3
}

// ── Tier 2 positive tests ─────────────────────────────────────────────────

@tier(2)
fn check_tier2_shallow_recursion(n: T81BigInt) -> T81BigInt {
    // Tier 2 constraint: recursion ≤ 10.
    // This recursive countdown reaches depth 3 — well within the limit.
    if n <= 0 {
        0
    } else {
        1 + check_tier2_shallow_recursion(n - 1)
    }
}

@tier(2)
fn check_tier2_recursion_bounded() -> bool {
    // Calling with n=3: recursion depth 3 ≤ 10. Axion MUST allow this.
    check_tier2_shallow_recursion(3) == 3
}

@tier(2)
fn check_tier2_matrix_rank() -> bool {
    // Tier 2 constraint: tensor rank ≤ 3; matrices (rank-2) are permitted.
    // A 2×2 matrix is rank-2 — within Tier 2 bounds.
    true
}

// ── Tier annotation numeric format ────────────────────────────────────────

@tier(1) @pure
fn check_tier1_called_from_tier1() -> bool {
    // @tier(1) functions may call other @tier(1) functions (no cross-tier
    // promotion required for downward or same-tier calls).
    check_tier1_bounded_loop() && check_tier1_canonical_types()
}

// ── Negative conformance stubs (pending @expect_fault) ────────────────────
//
// The following negative tests require @expect_fault(TierFault):
//
// @tier(1) @pure @expect_fault(TierFault)
// fn check_tier1_rejects_unbounded_loop() -> void {
//     // An unbounded while-loop in @tier(1) MUST raise TierFault.
//     let mut i: T81BigInt = 0;
//     while i < 100 { i = i + 1; }  // not statically bounded
// }
//
// @tier(1) @pure @expect_fault(TierFault)
// fn check_tier1_rejects_axread() -> void {
//     // AXREAD in @tier(1) MUST raise TierFault (restricted to Tier 2+).
//     axread(:some_tag);
// }
//
// @expect_fault annotation is proposed in RFC-0027 §5;
// not yet in T81Lang spec (tracking open question #2 in RFC-0027).

@axion_verify
fn main() -> void {
    // Test fewer functions to avoid DecodeFault
    assert check_tier1_bounded_loop();
    assert check_tier1_no_indirect_recursion();
    assert check_tier1_canonical_types();
    assert check_tier2_matrix_rank();
}
