fn main() -> i32 {
    let empty_set: Set[T81String] = std.collections.set();
    print(std.collections.set_size(empty_set));
    print(std.collections.set_has(empty_set, "city"));

    let s0: Set[T81String] = std.collections.set();
    let s1: Set[T81String] = std.collections.set_add(s0, "city");
    let s2: Set[T81String] = std.collections.set_add(s1, "lang");
    let staged_set: Set[T81String] = std.collections.set_add(s2, "city");

    print(std.collections.set_size(staged_set));
    print(std.collections.set_has(staged_set, "city"));
    print(std.collections.set_has(staged_set, "lang"));
    print(std.collections.set_has(staged_set, "missing"));
    return 0;
}
