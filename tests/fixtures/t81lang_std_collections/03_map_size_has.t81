fn main() -> i32 {
    let empty_map: Vector[T81String] = std.collections.map();
    print(std.collections.map_size(empty_map));
    print(std.collections.map_has(empty_map, "city"));

    let flat: Vector[T81String] = ["city", "sf", "lang", "t81"];
    print(std.collections.map_size(flat));
    print(std.collections.map_has(flat, "city"));
    print(std.collections.map_has(flat, "lang"));
    print(std.collections.map_has(flat, "missing"));

    let odd_flat: Vector[T81String] = ["a", "1", "dangling"];
    print(std.collections.map_size(odd_flat));
    print(std.collections.map_has(odd_flat, "a"));
    print(std.collections.map_has(odd_flat, "dangling"));
    return 0;
}
