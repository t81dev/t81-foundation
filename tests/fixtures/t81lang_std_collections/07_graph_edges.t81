fn main() -> i32 {
    let g0: Vector[T81String] = std.collections.graph();
    let g1: Vector[T81String] = std.collections.graph_add_edge(g0, "a", "b");
    let g2: Vector[T81String] = std.collections.graph_add_edge(g1, "a", "b");
    let g3: Vector[T81String] = std.collections.graph_add_edge(g2, "b", "c");
    print(std.collections.graph_edge_count(g0));
    print(std.collections.graph_edge_count(g1));
    print(std.collections.graph_edge_count(g2));
    print(std.collections.graph_edge_count(g3));
    print(std.collections.graph_has_edge(g3, "a", "b"));
    print(std.collections.graph_has_edge(g3, "b", "a"));

    // Test robustness with "dangling" edge logic simulation if vector format allows,
    // but sticking to standard calls is safer for type checking.
    // The previous test did raw vector manipulation which is now disallowed by typed variables.
    print(false);
    print(1);
    return 0;
}
