fn main() -> i32 {
    let g0: Vector[T81String] = std.collections.graph();
    let g1: Vector[T81String] = std.collections.graph_add_edge(g0, "a", "b");
    let g2: Vector[T81String] = std.collections.graph_add_edge(g1, "b", "c");
    let g3: Vector[T81String] = std.collections.graph_add_edge(g2, "a", "b");

    print(std.collections.graph_edge_count(g3));

    test_nested(g3);

    return 0;
}

fn test_nested(g3: Vector[T81String]) -> void {
    let g4: Vector[T81String] = std.collections.graph_remove_edge(g3, "a", "b");
    let g5: Vector[T81String] = std.collections.graph_remove_edge(g4, "x", "y");

    print(std.collections.graph_edge_count(g4));
    print(std.collections.graph_edge_count(g5));
    let has1: bool = std.collections.graph_has_edge(g4, "a", "b");
    print(has1);
    let has2: bool = std.collections.graph_has_edge(g4, "b", "c");
    print(has2);

    let tmp_g0: Vector[T81String] = std.collections.graph();
    let tmp_g1: Vector[T81String] = std.collections.graph_add_edge(tmp_g0, "a", "b");
    let g_odd_removed: Vector[T81String] = std.collections.graph_remove_edge(tmp_g1, "a", "b");

    print(std.collections.graph_edge_count(g_odd_removed));
    print(std.collections.graph_has_edge(g_odd_removed, "a", "b"));
}
