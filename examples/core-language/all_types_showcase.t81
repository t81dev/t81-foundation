fn main() -> i32 {
    // Basic integers
    let x: i32 = 42;
    let y: i32 = 7;
    let sum: i32 = x + y;
    
    // T81Float with proper suffix
    let ratio: T81Float = 2.5t81;
    let adjusted: T81Float = ratio + 1.5t81;
    
    // T81BigInt with proper suffix
    let big: T81BigInt = 123456789t81;
    let result: T81BigInt = big + 1000000t81;
    
    // Print everything
    print(sum);
    print(adjusted);
    print(result);
    
    return 0;
}
