// Advanced datatypes showcase aligned with current T81Lang support.

fn build_vector() -> T81Vector[i32, 4] {
    return [3, 6, 9, 12];
}

fn option_result_flow(flag: i32) -> Result[i32, T81String] {
    var maybe: Option[i32] = None();
    if (flag > 0) {
        maybe = Some(flag * 2);
    }

    let value = match (maybe) {
        Some(v) => v;
        None => -1;
    };

    if (value >= 0) {
        return Ok(value + 10);
    }
    return Err("inactive");
}

fn main() -> i32 {
    let axis = build_vector();
    let score: i32 = axis[0] + axis[1] + axis[2] + axis[3];

    let res = option_result_flow(score);
    let final_value = match (res) {
        Ok(v) => v;
        Err(_) => 0;
    };

    print(final_value);
    return final_value;
}
