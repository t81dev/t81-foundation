fn graph_demo() -> i32 {
    // Matrix[T] literals are not enabled in the current frontend; use vectors.
    let row0: T81Vector[i32, 3] = [0, 1, 1];
    let row1: T81Vector[i32, 3] = [1, 0, 0];
    let row2: T81Vector[i32, 3] = [1, 0, 0];
    let total_edges: i32 = row0[1] + row0[2] + row1[0] + row2[0];
    return total_edges;
}

fn main() -> i32 {
    return graph_demo();
}
