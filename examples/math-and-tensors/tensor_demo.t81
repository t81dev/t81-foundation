fn tensor_demo() -> i32 {
    // Tensor literals are not enabled in the current frontend; use vectors.
    let base: T81Vector[i32, 4] = [1, 1, 1, 1];
    let repeat: T81Vector[i32, 4] = [2, 2, 2, 2];
    let value: i32 = base[0] + repeat[0];
    if (value > 0) {
        return value;
    }
    return 0;
}

fn main() -> i32 {
    return tensor_demo();
}
