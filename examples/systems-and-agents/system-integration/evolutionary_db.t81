// Policy-governed evolutionary DB placeholder using supported language features.
fn query(depth_seed: i32) -> i32 {
    return depth_seed + 10;
}

fn main() -> i32 {
    var queries_processed: i32 = 0;
    var max_depth: i32 = 50;

    @bounded(infinite) loop {
        if (queries_processed >= 5) {
            break;
        }

        let depth = query(queries_processed);
        if (depth > max_depth) {
            max_depth = max_depth + 10;
        }

        queries_processed = queries_processed + 1;
    }

    print(queries_processed);
    return queries_processed;
}
