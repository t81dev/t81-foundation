// Distributed inference placeholder aligned with current frontend capabilities.
fn main() -> i32 {
    let shard_a: i32 = 21;
    let shard_b: i32 = 2;
    let result: i32 = shard_a * shard_b;

    var latency_ms: i32 = 120;
    let threshold_ms: i32 = 100;
    if (latency_ms > threshold_ms) {
        latency_ms = latency_ms - 15;
    }

    print(result);
    print(latency_ms);
    return result;
}
