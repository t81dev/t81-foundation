// Auditable autonomous-agent style control loop compatible with current frontend.
fn main() -> i32 {
    var steps: i32 = 0;
    var score: i32 = 0;

    @bounded(infinite) loop {
        if (steps >= 3) {
            break;
        }

        if (steps % 2 == 0) {
            score = score + 2;
        } else {
            score = score + 1;
        }

        steps = steps + 1;
    }

    print(score);
    return score;
}
