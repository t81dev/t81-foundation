// T81 Neural Network Demo - Working around the compiler bug
// Demonstrates control flow, vector operations, and neural network primitives

// Simple dot product for 4-element vectors using i32
fn dot_product_int(a: T81Vector[i32, 4], b: T81Vector[i32, 4]) -> i32 {
    var sum: i32 = 0;
    var i: i32 = 0;
    while (i < 4) {
        sum = sum + a[i] * b[i];
        i = i + 1;
    }
    return sum;
}

// Simple activation function (linear)
fn simple_activate(x: i32) -> i32 {
    return x / 2 + 1;
}

// Neural network neuron computation
fn compute_neuron(input: T81Vector[i32, 4], weights: T81Vector[i32, 4]) -> i32 {
    let sum: i32 = dot_product_int(input, weights);
    return simple_activate(sum);
}

// Forward pass through simple neural network - avoiding vector reassignment
fn forward_pass(input0: i32, input1: i32) -> i32 {
    // Compute manually without creating intermediate vectors
    let hidden_sum: i32 = input0 * 5 + input1 * 3 + 1;
    let hidden_output: i32 = hidden_sum / 2 + 1;
    
    // Output computation
    let output_sum: i32 = hidden_output * 6 + 0 + 1;
    let output: i32 = output_sum / 2 + 1;
    
    return output;
}

// Vector operations demonstration
fn demo_vector_ops() -> i32 {
    print("Vector Operations Demo");
    
    let v1: T81Vector[i32, 4] = [1, 2, 3, 4];
    let v2: T81Vector[i32, 4] = [5, 1, 2, 3];
    
    let dot_result: i32 = dot_product_int(v1, v2);
    print("Dot product result:");
    print(dot_result);
    
    return 0;
}

// Control flow demonstration
fn demo_control_flow() -> i32 {
    print("Control Flow Demo");
    
    var i: i32 = 0;
    while (i < 5) {
        print("Loop iteration:");
        print(i);
        i = i + 1;
    }
    
    return 0;
}

// Main program
fn main() -> i32 {
    print("T81 Neural Network Demo");
    
    // Test neural network
    let input_x: i32 = 8;
    let input_y: i32 = 3;
    
    print("Input X:");
    print(input_x);
    print("Input Y:");
    print(input_y);
    
    let network_output: i32 = forward_pass(input_x, input_y);
    print("Network Output:");
    print(network_output);
    
    // Run demonstrations
    demo_vector_ops();
    demo_control_flow();
    
    return 0;
}
