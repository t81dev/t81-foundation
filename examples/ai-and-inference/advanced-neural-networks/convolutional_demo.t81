// Convolutional Neural Network Demo in T81Lang
// EXPERIMENTAL - NOT FOR PRODUCTION USE
// Demonstrates convolutional layer capabilities with Advanced AI opcodes

@extern "advanced_ai"

// Neural network configuration types
type NeuralLayer = struct {
    layer_type: int,      // DENSE=0, CONV1D=1, CONV2D=2, LSTM=3, TRANSFORMER=4
    input_size: int,
    output_size: int,
    activation: int,      // RELU=0, GELU=1, SWISH=2, SIGMOID=3, TANH=4, SELU=5
    seed: uint64
};

// Convolutional layer specific configuration
type ConvConfig = struct {
    input_channels: int,
    output_channels: int,
    kernel_size: int,
    stride: int,
    padding: int
};

// Neural network operations with policy annotations
@neural @tier(2) @deterministic
function neural_forward(dest: int, input: int, layer_id: int) -> void;

@neural @tier(3) @deterministic  
function neural_backward(dest: int, grad: int, layer_id: int) -> void;

@neural @tier(3) @deterministic
function neural_optimize(layer_id: int, learning_rate: float) -> void;

@neural @tier(2) @deterministic
function neural_activation(dest: int, input: int, activation_type: int) -> void;

// Helper functions for convolutional networks
@tier(2) @pure
function create_conv1d_layer(input_channels: int, output_channels: int, kernel_size: int, 
                           activation: int, seed: uint64) -> int {
    var layer_config: NeuralLayer;
    layer_config.layer_type = 1; // CONV1D
    layer_config.input_size = input_channels * 1000; // Packed format
    layer_config.output_size = output_channels;
    layer_config.activation = activation;
    layer_config.seed = seed;
    
    // Pack convolution parameters into hidden_size
    // Format: (input_channels << 20) | (output_channels << 10) | kernel_size
    layer_config.hidden_size = (input_channels << 20) | (output_channels << 10) | kernel_size;
    
    // Store layer configuration in CanonFS for provenance
    var layer_id = allocate_layer_id();
    store_layer_config(layer_id, layer_config);
    
    return layer_id;
}

@tier(2) @pure
function create_dense_layer(input_size: int, output_size: int, activation: int, seed: uint64) -> int {
    var layer_config: NeuralLayer;
    layer_config.layer_type = 0; // DENSE
    layer_config.input_size = input_size;
    layer_config.output_size = output_size;
    layer_config.activation = activation;
    layer_config.seed = seed;
    
    var layer_id = allocate_layer_id();
    store_layer_config(layer_id, layer_config);
    
    return layer_id;
}

@tier(2) @deterministic
function conv_forward(layer_id: int, input_tensor: int) -> int {
    var output_tensor = allocate_tensor();
    
    // Execute NEURAL_FWD opcode
    neural_forward(output_tensor, input_tensor, layer_id);
    
    // Store provenance
    var proof = create_provenance_entry("conv_forward", layer_id, input_tensor, output_tensor);
    canonfs_store(proof);
    
    return output_tensor;
}

@tier(2) @deterministic
function dense_forward(layer_id: int, input_tensor: int) -> int {
    var output_tensor = allocate_tensor();
    
    // Execute NEURAL_FWD opcode
    neural_forward(output_tensor, input_tensor, layer_id);
    
    // Store provenance
    var proof = create_provenance_entry("dense_forward", layer_id, input_tensor, output_tensor);
    canonfs_store(proof);
    
    return output_tensor;
}

// Generate synthetic time series data for convolutional demo
@tier(2)
function generate_time_series_data(num_samples: int, sequence_length: int, num_channels: int) -> array {
    var dataset = allocate_array(num_samples);
    
    for (var i = 0; i < num_samples; i = i + 1) {
        var sequence = allocate_tensor();
        
        for (var t = 0; t < sequence_length; t = t + 1) {
            for (var c = 0; c < num_channels; c = c + 1) {
                // Generate sinusoidal pattern with noise
                var base_freq = 0.1 + (c * 0.05);
                var phase = (i * 0.1) + (c * 0.5);
                var noise = (random_float() - 0.5) * 0.1;
                
                var value = sin(base_freq * t + phase) + noise;
                sequence[c * sequence_length + t] = value;
            }
        }
        
        dataset[i] = sequence;
    }
    
    return dataset;
}

// Simple CNN for time series classification
@tier(2)
function time_series_classification_demo() -> void {
    print("=== Time Series Classification with CNN Demo ===");
    
    // Generate synthetic time series data
    var num_samples = 1000;
    var sequence_length = 50;
    var num_channels = 3;
    
    print("Generating synthetic time series data...");
    var dataset = generate_time_series_data(num_samples, sequence_length, num_channels);
    var labels = generate_classification_labels(num_samples, 5); // 5 classes
    
    print("Generated dataset: ", num_samples, " samples, ", sequence_length, " timesteps, ", num_channels, " channels");
    
    // Create CNN architecture
    // Conv1D layer: 3 channels -> 16 filters, kernel_size=5
    var conv1 = create_conv1d_layer(3, 16, 5, 1, 12345); // ReLU activation
    print("Created Conv1D layer: 3->16 channels, kernel_size=5");
    
    // Conv1D layer: 16 channels -> 32 filters, kernel_size=3
    var conv2 = create_conv1d_layer(16, 32, 3, 1, 12346); // ReLU activation
    print("Created Conv1D layer: 16->32 channels, kernel_size=3");
    
    // Dense layer for classification
    // Calculate flattened size: 32 * (50 - 5 + 1 - 3 + 1) = 32 * 44 = 1408
    var dense1 = create_dense_layer(1408, 128, 1, 12347); // ReLU activation
    print("Created Dense layer: 1408->128");
    
    // Output layer
    var output_layer = create_dense_layer(128, 5, 3, 12348); // Sigmoid activation
    print("Created Output layer: 128->5");
    
    // Training parameters
    var epochs = 10;
    var learning_rate = 0.001;
    var batch_size = 32;
    
    print("Starting training for ", epochs, " epochs...");
    
    // Training loop
    for (var epoch = 0; epoch < epochs; epoch = epoch + 1) {
        var total_loss = 0.0;
        var correct_predictions = 0;
        
        // Mini-batch training
        for (var batch_start = 0; batch_start < num_samples; batch_start = batch_start + batch_size) {
            var batch_end = min(batch_start + batch_size, num_samples);
            
            for (var i = batch_start; i < batch_end; i = i + 1) {
                // Forward pass through CNN
                var input = dataset[i];
                
                // Conv1D layer 1
                var conv1_output = conv_forward(conv1, input);
                
                // Conv1D layer 2
                var conv2_output = conv_forward(conv2, conv1_output);
                
                // Flatten for dense layer
                var flattened = flatten_tensor(conv2_output);
                
                // Dense layer 1
                var dense1_output = dense_forward(dense1, flattened);
                
                // Output layer
                var final_output = dense_forward(output_layer, dense1_output);
                
                // Convert to prediction (argmax)
                var prediction = argmax(final_output);
                var target_label = labels[i];
                
                if (prediction == target_label) {
                    correct_predictions = correct_predictions + 1;
                }
                
                // Compute loss (simplified cross-entropy)
                var one_hot_target = one_hot_encode(target_label, 5);
                var loss = compute_cross_entropy_loss(final_output, one_hot_target);
                total_loss = total_loss + loss;
                
                // Backward pass and weight updates (simplified)
                var grad_output = compute_loss_gradient(final_output, one_hot_target);
                
                // Update output layer
                neural_backward(output_layer, grad_output, output_layer);
                neural_optimize(output_layer, learning_rate);
                
                // Update dense layer 1
                var dense1_grad = compute_dense_gradient(dense1_output, grad_output);
                neural_backward(dense1, dense1_grad, dense1);
                neural_optimize(dense1, learning_rate);
                
                // Update conv layers (simplified)
                var conv2_grad = compute_conv_gradient(conv2_output, dense1_grad);
                neural_backward(conv2, conv2_grad, conv2);
                neural_optimize(conv2, learning_rate);
                
                var conv1_grad = compute_conv_gradient(conv1_output, conv2_grad);
                neural_backward(conv1, conv1_grad, conv1);
                neural_optimize(conv1, learning_rate);
            }
        }
        
        var accuracy = (correct_predictions * 100.0) / num_samples;
        var avg_loss = total_loss / num_samples;
        
        print("Epoch ", epoch, ": Loss = ", avg_loss, ", Accuracy = ", accuracy, "%");
        
        // Store epoch provenance
        var epoch_proof = create_epoch_proof(epoch, avg_loss, accuracy);
        canonfs_store(epoch_proof);
    }
    
    // Test on validation set
    var test_samples = 100;
    var test_correct = 0;
    
    for (var i = 0; i < test_samples; i = i + 1) {
        var input = dataset[num_samples - test_samples + i];
        
        // Forward pass
        var conv1_output = conv_forward(conv1, input);
        var conv2_output = conv_forward(conv2, conv1_output);
        var flattened = flatten_tensor(conv2_output);
        var dense1_output = dense_forward(dense1, flattened);
        var final_output = dense_forward(output_layer, dense1_output);
        
        var prediction = argmax(final_output);
        var target_label = labels[num_samples - test_samples + i];
        
        if (prediction == target_label) {
            test_correct = test_correct + 1;
        }
    }
    
    var test_accuracy = (test_correct * 100.0) / test_samples;
    print("Test Accuracy: ", test_accuracy, "%");
    
    // Store complete training provenance
    var training_summary = create_training_summary(
        epochs, learning_rate, test_accuracy, "cnn_time_series"
    );
    canonfs_store(training_summary);
}

// Convolutional feature extraction demo
@tier(2)
function convolutional_features_demo() -> void {
    print("=== Convolutional Feature Extraction Demo ===");
    
    // Create sample signal (e.g., audio or sensor data)
    var signal_length = 100;
    var num_channels = 4;
    var signal = allocate_tensor();
    
    print("Generating sample signal with ", num_channels, " channels, length ", signal_length);
    
    for (var t = 0; t < signal_length; t = t + 1) {
        for (var c = 0; c < num_channels; c = c + 1) {
            // Multi-frequency signal with channel-specific characteristics
            var freq1 = 0.05 + (c * 0.02);
            var freq2 = 0.15 + (c * 0.03);
            var amplitude = 1.0 - (c * 0.2);
            var noise = (random_float() - 0.5) * 0.05;
            
            var value = amplitude * (sin(freq1 * t) + 0.5 * sin(freq2 * t)) + noise;
            signal[c * signal_length + t] = value;
        }
    }
    
    // Create multiple convolutional layers for feature extraction
    var conv1 = create_conv1d_layer(4, 8, 7, 1, 20001); // ReLU
    var conv2 = create_conv1d_layer(8, 16, 5, 1, 20002); // ReLU
    var conv3 = create_conv1d_layer(16, 32, 3, 1, 20003); // ReLU
    
    print("Created 3-layer convolutional feature extractor");
    
    // Extract features at different scales
    print("Extracting convolutional features...");
    
    // Layer 1 features (low-level)
    var features1 = conv_forward(conv1, signal);
    print("Layer 1 features: ", get_tensor_size(features1), " elements");
    
    // Layer 2 features (mid-level)
    var features2 = conv_forward(conv2, features1);
    print("Layer 2 features: ", get_tensor_size(features2), " elements");
    
    // Layer 3 features (high-level)
    var features3 = conv_forward(conv3, features2);
    print("Layer 3 features: ", get_tensor_size(features3), " elements");
    
    // Analyze feature statistics
    print("Feature Analysis:");
    
    var stats1 = compute_tensor_statistics(features1);
    print("  Layer 1 - Mean: ", stats1.mean, ", Std: ", stats1.std_dev);
    
    var stats2 = compute_tensor_statistics(features2);
    print("  Layer 2 - Mean: ", stats2.mean, ", Std: ", stats2.std_dev);
    
    var stats3 = compute_tensor_statistics(features3);
    print("  Layer 3 - Mean: ", stats3.mean, ", Std: ", stats3.std_dev);
    
    // Demonstrate different receptive fields
    print("Receptive Field Analysis:");
    print("  Layer 1 kernel: 7 samples (", (7.0 / signal_length) * 100, "% of signal)");
    print("  Layer 2 kernel: 5 samples (", (5.0 / signal_length) * 100, "% of signal)");
    print("  Layer 3 kernel: 3 samples (", (3.0 / signal_length) * 100, "% of signal)");
    
    // Store feature extraction provenance
    var feature_proof = create_feature_extraction_proof(signal, features1, features2, features3);
    canonfs_store(feature_proof);
    
    print("Convolutional feature extraction completed");
}

// Convolutional layer parameter analysis
@tier(2)
function convolutional_parameter_analysis() -> void {
    print("=== Convolutional Layer Parameter Analysis ===");
    
    // Test different convolutional configurations
    var test_configs = [
        {input_channels: 1, output_channels: 4, kernel_size: 3},
        {input_channels: 1, output_channels: 8, kernel_size: 5},
        {input_channels: 3, output_channels: 16, kernel_size: 3},
        {input_channels: 3, output_channels: 32, kernel_size: 7},
        {input_channels: 8, output_channels: 64, kernel_size: 5}
    ];
    
    for (var i = 0; i < test_configs.length; i = i + 1) {
        var config = test_configs[i];
        
        print("Testing configuration ", i, ":");
        print("  Input channels: ", config.input_channels);
        print("  Output channels: ", config.output_channels);
        print("  Kernel size: ", config.kernel_size);
        
        // Create convolutional layer
        var conv_layer = create_conv1d_layer(
            config.input_channels, 
            config.output_channels, 
            config.kernel_size, 
            1, // ReLU
            30000 + i
        );
        
        // Calculate parameter count
        var weight_params = config.input_channels * config.output_channels * config.kernel_size;
        var bias_params = config.output_channels;
        var total_params = weight_params + bias_params;
        
        print("  Weight parameters: ", weight_params);
        print("  Bias parameters: ", bias_params);
        print("  Total parameters: ", total_params);
        
        // Test forward pass with dummy input
        var input_length = 50;
        var dummy_input = allocate_tensor();
        
        // Initialize dummy input
        for (var j = 0; j < config.input_channels * input_length; j = j + 1) {
            dummy_input[j] = random_float() * 2.0 - 1.0;
        }
        
        // Forward pass
        var start_time = get_current_time();
        var output = conv_forward(conv_layer, dummy_input);
        var end_time = get_current_time();
        
        var execution_time = end_time - start_time;
        var output_size = get_tensor_size(output);
        
        print("  Output size: ", output_size, " elements");
        print("  Execution time: ", execution_time, " μs");
        print("  Throughput: ", (output_size / execution_time) * 1000000, " elements/second");
        print("");
    }
    
    print("Convolutional parameter analysis completed");
}

// Main program
@tier(2)
function main() -> void {
    print("Convolutional Neural Network Demo in T81Lang");
    print("==========================================");
    print("Status: EXPERIMENTAL - NOT FOR PRODUCTION USE");
    print("");
    
    // Run all convolutional demos
    convolutional_features_demo();
    print("");
    
    convolutional_parameter_analysis();
    print("");
    
    time_series_classification_demo();
    print("");
    
    print("All convolutional neural network demos completed successfully!");
    print("Complete provenance stored in CanonFS for reproducibility.");
    print("");
    print("Convolutional layer capabilities:");
    print("✅ 1D Convolution with configurable kernels");
    print("✅ Multi-channel input/output support");
    print("✅ Stride and padding configuration");
    print("✅ Integration with dense layers");
    print("✅ Policy-gated execution");
    print("✅ Deterministic computation");
    print("✅ Complete provenance tracking");
}
